{
  "manifest_version": 3,
  "name": "Social Arabic Font Beautifier (X & Facebook)",
  "version": "3.0",
  "description": "تحسين الخط العربي في تويتر (X) وفيسبوك إلى خط IBM Plex Arabic مع إمكانية تفعيل أو إيقاف كل موقع بسهولة.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "إعدادات الخط العربي (X & Facebook)"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://facebook.com/*",
        "https://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
